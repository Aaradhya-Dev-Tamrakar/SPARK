\ExplSyntaxOn
\keys_define:nn { signature }
{
	name .tl_set:N = \l_signature_name_tl,
	designation .tl_set:N = \l_signature_designation_tl,
	affiliation .tl_set:N = \l_signature_affiliation_tl,
}

\NewDocumentCommand{\signatureblock}{m}
{
	\keys_set:nn { signature } { #1 }
	\centering
	\noindent\rule{6cm}{0.4pt}\\[0.2cm]
	\textbf{\l_signature_name_tl}\\
	(\l_signature_designation_tl)\\
	\l_signature_affiliation_tl
}
\ExplSyntaxOff

