% ---------- List of Abbreviations (dynamic -- no makeindex required) ----------
\usepackage{longtable}
% Internal key list (requires etoolbox, loaded later in this sty)
\newcommand{\kec@abbrlist}{}
% \regabbr{KEY}{Expansion} -- silent registration, no inline output
%   Stores expansion and appends KEY to the internal list
\newcommand{\regabbr}[2]{%
  \expandafter\gdef\csname kec@abbr@#1\endcsname{#2}%
  \ifdefempty{\kec@abbrlist}{%
    \gdef\kec@abbrlist{#1}%
  }{%
    \expandafter\gdef\expandafter\kec@abbrlist\expandafter{\kec@abbrlist,#1}%
  }%
}
% \abbr{KEY}{Expansion} -- inline first-use: prints "Expansion (KEY)"
\newcommand{\abbr}[2]{#2 (#1)}
% \printabbreviations -- renders all registered entries in insertion order
\newcommand{\kec@printone}[1]{%
  \textbf{#1} & \csname kec@abbr@#1\endcsname \\[4pt]%
}
\newcommand{\printabbreviations}{%
  \chapter*{\scshape List of Abbreviations}%
  \begin{longtable}{@{}p{3cm}p{11.5cm}@{}}%
    \forlistcsloop{\kec@printone}{kec@abbrlist}%
  \end{longtable}%
}
